# ─── Zoho API Configuration ──────────────────────────────────────────────────
# 1. Go to https://api-console.zoho.com -> Add Client -> Self Client.
# 2. Scope: Desk.tickets.READ,Desk.search.READ,Desk.basic.READ,Desk.settings.READ,Desk.contacts.READ
# 3. Time Duration: 10 minutes -> Generate Code.
# 4. Exchange code for Refresh Token via CURL:
#    curl -X POST https://accounts.zoho.com/oauth/v2/token \
#      -d "code={GENERATED_CODE}" \
#      -d "client_id={CLIENT_ID}" \
#      -d "client_secret={CLIENT_SECRET}" \
#      -d "grant_type=authorization_code"

ZOHO_CLIENT_ID=your_client_id
ZOHO_CLIENT_SECRET=your_client_secret
ZOHO_REFRESH_TOKEN=your_refresh_token

# Your Zoho data center: com | eu | in | au | jp
ZOHO_DC=com

# Optional: paste your orgId from Zoho Desk Settings → Developer Space
# If blank, it will be auto-fetched on first sync
ZOHO_ORG_ID=

# ─── Thresholds (all configurable) ───────────────────────────────────────────
# How often to sync (minutes)
SYNC_INTERVAL_MINUTES=15

# Tickets with no update for this many hours AFTER SLA breach are flagged
NO_ACTION_THRESHOLD_HOURS=24

# Severity classification thresholds (hours overdue)
SEVERITY_CRITICAL_HOURS=72
SEVERITY_MODERATE_HOURS=24
